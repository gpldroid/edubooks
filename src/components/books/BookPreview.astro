---
import { books, categories, type Book } from '../../data/catalog';
interface Props { book: Book; base: string; }
const { book, base } = Astro.props;
const coverUrl = base + book.cover.slice(1);
const category = categories.find((item) => item.slug === book.category);
const previewUrl = book.previewPdf ? base + book.previewPdf.replace(/^\//, '') : '';
const readerUrl = book.downloadPdf ? base + book.downloadPdf.replace(/^\//, '') : previewUrl;
---
<article class="book-detail">
  <div class="book-intro">
    <figure class="detail-cover"><img src={coverUrl} alt={book.coverAlt} decoding="async"><figcaption data-en="Book cover" data-fr="Couverture du livre" data-es="Portada del libro">Book cover</figcaption></figure>
    <div class="book-summary">
      <span class="preview-label" data-en="BOOK INFORMATION" data-fr="INFORMATIONS SUR LE LIVRE" data-es="INFORMACIÓN DEL LIBRO">BOOK INFORMATION</span>
      <h2 data-en="About this book" data-fr="À propos de ce livre" data-es="Sobre este libro">About this book</h2>
      <p class="description" data-en={book.description} data-fr={book.descriptionFr} data-es={book.descriptionEs}>{book.description}</p>
      <dl class="book-facts">
        <div><dt data-en="Category" data-fr="Catégorie" data-es="Categoría">Category</dt><dd data-en={category?.nameEn ?? book.category} data-fr={category?.nameFr ?? book.category} data-es={category?.nameEs ?? book.category}>{category?.nameEn ?? book.category}</dd></div>
        <div><dt data-en="Language" data-fr="Langue" data-es="Idioma">Language</dt><dd>{book.language.toUpperCase()}</dd></div>
        <div><dt data-en="Format" data-fr="Format" data-es="Formato">Format</dt><dd>PDF</dd></div>
        {book.level && <div><dt data-en="Level" data-fr="Niveau" data-es="Nivel">Level</dt><dd>{book.level}</dd></div>}
        {book.pages && <div><dt data-en="Full book pages" data-fr="Pages du livre complet" data-es="Páginas del libro completo">Full book pages</dt><dd>{book.pages}</dd></div>}
        {book.author && <div><dt data-en="Author" data-fr="Auteur" data-es="Autor">Author</dt><dd>{book.author}</dd></div>}
      </dl>
      {book.status === 'published' && readerUrl ? <><p class="reader-summary" data-en="Read the complete published book in your browser’s built-in PDF reader. The overview and table of contents remain on this page." data-fr="Lisez le livre publié complet dans le lecteur PDF intégré à votre navigateur. La présentation et le sommaire restent disponibles sur cette page." data-es="Lee el libro publicado completo en el lector PDF integrado de tu navegador. La descripción y el índice permanecen en esta página.">Read the complete published book in your browser’s built-in PDF reader. The overview and table of contents remain on this page.</p><div class="reader-actions"><a class="button-3d button-3d--compact preview-cta" href={readerUrl} target="_blank" rel="noopener noreferrer" data-en="Read book online" data-fr="Lire le livre en ligne" data-es="Leer el libro en línea">Read book online</a><a class="button-3d button-3d--dark download-cta" href={base + 'books/' + book.slug + '/download/'} data-en="Download PDF" data-fr="Télécharger le PDF" data-es="Descargar PDF">Download PDF</a></div></> : null}
    </div>
  </div>
  <section class="toc-section" aria-labelledby="toc-heading">
    <div class="toc-heading-row"><div><span class="preview-label" data-en="INSIDE THE BOOK" data-fr="DANS LE LIVRE" data-es="DENTRO DEL LIBRO">INSIDE THE BOOK</span><h2 id="toc-heading" data-en="Table of contents" data-fr="Sommaire" data-es="Índice">Table of contents</h2></div></div>
    <ol class="toc-list">{book.toc.map((item) => <li><span class="toc-title" data-en={item.titleEn} data-fr={item.titleFr} data-es={item.titleEs}>{item.titleEn}</span></li>)}</ol>
  </section>
</article>
<nav class="related-editions" aria-label="Related language editions">
  <h2 data-en="Explore this title in another language" data-fr="Découvrir ce livre dans une autre langue" data-es="Ver este libro en otro idioma">Explore this title in another language</h2>
  {books.filter((edition) => edition.slug.replace(/-(en|fr|es)$/, '') === book.slug.replace(/-(en|fr|es)$/, '') && edition.slug !== book.slug).map((edition) => <a href={base + 'books/' + edition.slug + '/'}>{edition.title} · {edition.language.toUpperCase()}</a>)}
</nav>
<style>
.book-detail{max-width:1080px;margin:0 auto}.book-intro{display:grid;grid-template-columns:minmax(220px,340px) minmax(0,1fr);gap:clamp(28px,5vw,58px);align-items:start}.detail-cover{position:relative;margin:0;padding:12px;border:1px solid #e3e9e8;border-radius:16px;background:#f2f5f3;box-shadow:0 16px 36px rgb(16 31 50 / 9%)}.detail-cover img{display:block;width:100%;height:auto;border-radius:8px}.detail-cover figcaption{padding:9px 4px 0;text-align:center;color:#71808c;font-size:11px}.book-summary{min-width:0}.preview-label{font-size:10px;letter-spacing:.15em;color:#388b82;font-weight:900}.book-summary h2,.toc-section h2{font-size:clamp(25px,3vw,34px);color:#183452;margin:7px 0 12px}.description{color:#586a7a;line-height:1.85;margin:0 0 22px}.book-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:0}.book-facts div{padding:12px;border:1px solid #e4ebe8;border-radius:10px;background:#fbfcfb}.book-facts dt{font-size:10px;color:#71808c;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.book-facts dd{margin:3px 0 0;color:#20354b;font-size:13px;font-weight:700;overflow-wrap:anywhere}.reader-summary{margin:20px 0 0;padding:12px 14px;border-left:3px solid #388b82;background:#f1f7f5;color:#49655f;font-size:12px}.toc-section{margin-top:clamp(38px,6vw,72px);padding:clamp(20px,3vw,34px);border:1px solid #e3eae7;border-radius:16px;background:#fff}.toc-heading-row{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:16px}.toc-section h2{margin-bottom:0}.toc-count{flex:none;padding:6px 10px;border-radius:30px;background:#edf5f2;color:#388b82;font-size:11px;font-weight:800}.toc-list{list-style:none;margin:0;padding:0;}.toc-list li{display:flex;align-items:baseline;gap:14px;padding:13px 2px;border-bottom:1px solid #edf0ef;}.toc-list li:last-child{border-bottom:0}.toc-title{flex:1;color:#20354b;font-size:14px;font-weight:600}.toc-page{color:#8a969f;font-size:12px;font-variant-numeric:tabular-nums}
 .reader-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.reader-actions .button-3d{flex:1 1 190px;min-width:0;text-align:center;text-decoration:none;white-space:normal;overflow-wrap:anywhere}.related-editions{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:30px;padding:20px;border:1px solid #e3eae7;border-radius:14px;background:#f7f9f8}.related-editions h2{flex-basis:100%;margin:0 0 5px;font-size:18px;color:#183452}.related-editions a{padding:8px 12px;border:1px solid #dce8e4;border-radius:8px;background:#fff;color:#28776f;font-size:13px;font-weight:700;text-decoration:none}
</style>
