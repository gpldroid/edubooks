---
import type { Book, LearningCategory } from '../../data/catalog';
interface Props { book: Book; category?: LearningCategory; base: string; }
const { book, category, base } = Astro.props;
const detailUrl = `${base}books/${book.slug}/`;
const downloadUrl = `${detailUrl}download/`;
const searchable = [book.title, book.titleFr, book.titleEs, book.description, book.descriptionFr, book.descriptionEs].join(' ');
const coverUrl = `${base}${book.cover.slice(1)}`;
---
<article class="book-card" data-category={book.category} data-search={searchable}>
  <a href={detailUrl} class="book-card-link" aria-label={`Preview ${book.title}`}>
    <div class="book-cover"><img src={coverUrl} alt={book.coverAlt} loading="lazy" decoding="async"><span class="preview-badge" data-en="BOOK DETAILS" data-fr="DÉTAILS DU LIVRE" data-es="DETALLES DEL LIBRO">BOOK DETAILS</span></div>
  </a>
  <div class="book-card-copy">
    <span class="book-category" data-en={category?.nameEn ?? 'Learning'} data-fr={category?.nameFr ?? 'Apprentissage'} data-es={category?.nameEs ?? 'Aprendizaje'}>{category?.nameEn ?? 'Learning'}</span>
    <h2><a href={detailUrl} data-en={book.title} data-fr={book.titleFr} data-es={book.titleEs}>{book.title}</a></h2>
    <p data-en={book.description} data-fr={book.descriptionFr} data-es={book.descriptionEs}>{book.description}</p>
    <div class="book-card-actions">
      <a class="button-3d button-3d--compact" href={detailUrl} data-en="Preview" data-fr="Aperçu" data-es="Vista previa">Preview</a>
      <a class="button-3d button-3d--compact button-3d--dark" href={downloadUrl} data-en="Download" data-fr="Télécharger" data-es="Descargar">Download</a>
    </div>
  </div>
</article>
<style>
.book-card{min-width:0;overflow:hidden;border:1px solid #e3e9e8;border-radius:16px;background:#fff;box-shadow:0 8px 24px rgb(16 31 50 / 5%);transition:transform .2s ease,box-shadow .2s ease}.book-card:hover{transform:translateY(-3px);box-shadow:0 16px 34px rgb(16 31 50 / 11%)}.book-card[hidden]{display:none}.book-card-link{display:block;color:inherit;text-decoration:none}.book-cover{position:relative;display:grid;place-items:center;aspect-ratio:4/3;overflow:hidden;background:#edf2f0}.book-cover img{width:100%;height:100%;object-fit:cover;object-position:center 35%}.preview-badge{position:absolute;right:12px;bottom:12px;padding:6px 10px;border-radius:999px;background:#183452;color:#fff;font-size:10px;font-weight:800;letter-spacing:.06em}.book-card-copy{padding:20px}.book-category{font-size:11px;color:#388b82;font-weight:800}.book-card h2{font-size:clamp(19px,2vw,23px);line-height:1.3;margin:8px 0;color:#183452}.book-card h2 a{color:inherit;text-decoration:none}.book-card p{font-size:14px;color:#586a7a;margin:0 0 18px;line-height:1.7}.book-card-actions{display:flex;flex-wrap:wrap;gap:10px}.book-card-actions .button-3d{flex:1 1 110px;text-decoration:none;font-size:12px}
@media(max-width:420px){.book-card-actions{display:grid;grid-template-columns:1fr 1fr}}
@media(prefers-reduced-motion:reduce){.book-card{transition:none}.book-card:hover{transform:none}}
</style>