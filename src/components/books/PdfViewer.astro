---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
const viewerSrc = `${src}#toolbar=1&navpanes=0&view=FitH`;
---

<section class="pdf-preview" aria-labelledby="pdf-preview-heading">
  <div class="pdf-preview-heading">
    <div>
      <span class="eyebrow" data-en="SAMPLE PAGES" data-fr="PAGES D’APERÇU" data-es="PÁGINAS DE MUESTRA">SAMPLE PAGES</span>
      <h2 id="pdf-preview-heading" data-en="Read the PDF preview" data-fr="Lire l’aperçu PDF" data-es="Leer la vista previa PDF">Read the PDF preview</h2>
      <p data-en="Read the sample directly on this page. The preview opens in your browser and does not require downloading the complete book." data-fr="Lisez l’extrait directement sur cette page. L’aperçu s’ouvre dans votre navigateur sans télécharger le livre complet." data-es="Lee la muestra directamente en esta página. La vista previa se abre en tu navegador sin descargar el libro completo.">Read the sample directly on this page. The preview opens in your browser and does not require downloading the complete book.</p>
    </div>
    <div class="pdf-preview-actions">
      <a class="open-pdf" href={src} target="_blank" rel="noopener noreferrer" data-en="Open PDF in new tab" data-fr="Ouvrir le PDF dans un nouvel onglet" data-es="Abrir PDF en una pestaña nueva">Open PDF in new tab ↗</a>
      <a class="open-pdf open-pdf--secondary" href={src} download data-en="Download sample" data-fr="Télécharger l’extrait" data-es="Descargar muestra">Download sample</a>
    </div>
  </div>

  <div class="pdf-viewer-shell" data-pdf-viewer>
    <div class="pdf-viewer-toolbar">
      <span class="pdf-viewer-title">{title}</span>
      <button class="pdf-fullscreen" type="button" data-pdf-fullscreen aria-label="View PDF preview in full screen" aria-pressed="false" data-en="Full screen" data-fr="Plein écran" data-es="Pantalla completa">Full screen</button>
    </div>
    <div class="pdf-frame">
      <object data={src} type="application/pdf" aria-label={title}>
        <iframe src={viewerSrc} title={title} loading="lazy">
          <p data-en="Your browser cannot display embedded PDFs." data-fr="Votre navigateur ne peut pas afficher les PDF intégrés." data-es="Tu navegador no puede mostrar PDF incrustados.">Your browser cannot display embedded PDFs.</p>
          <a href={src} target="_blank" rel="noopener noreferrer" data-en="Open the PDF preview" data-fr="Ouvrir l’aperçu PDF" data-es="Abrir la vista previa PDF">Open the PDF preview</a>
        </iframe>
      </object>
    </div>
  </div>
  <p class="pdf-viewer-help" data-en="If the preview does not appear, use “Open PDF in new tab” to read it with your browser’s PDF reader." data-fr="Si l’aperçu ne s’affiche pas, utilisez « Ouvrir le PDF dans un nouvel onglet » pour le lire avec le lecteur PDF de votre navigateur." data-es="Si no aparece la vista previa, usa «Abrir PDF en una pestaña nueva» para leerlo con el visor PDF de tu navegador.">If the preview does not appear, use “Open PDF in new tab” to read it with your browser’s PDF reader.</p>
</section>

<script>
  const viewer = document.querySelector<HTMLElement>('[data-pdf-viewer]');
  const fullscreenButton = viewer?.querySelector<HTMLButtonElement>('[data-pdf-fullscreen]');

  if (viewer && fullscreenButton) {
    if (!viewer.requestFullscreen) {
      fullscreenButton.hidden = true;
    } else {
      fullscreenButton.addEventListener('click', async () => {
        try {
          if (document.fullscreenElement === viewer) {
            await document.exitFullscreen();
          } else {
            await viewer.requestFullscreen();
          }
        } catch {
          fullscreenButton.setAttribute('aria-pressed', 'false');
        }
      });

      document.addEventListener('fullscreenchange', () => {
        fullscreenButton.setAttribute('aria-pressed', String(document.fullscreenElement === viewer));
      });
    }
  }
</script>

<style>
  .pdf-preview{margin-top:clamp(36px,5vw,64px);padding:clamp(18px,3vw,30px);border:1px solid #e2e9e7;border-radius:18px;background:#f7f9f8}
  .pdf-preview-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
  .eyebrow{font-size:10px;letter-spacing:.16em;font-weight:800;color:#388b82}
  .pdf-preview h2{font-size:clamp(22px,3vw,30px);margin:5px 0;color:#183452}
  .pdf-preview-heading p{max-width:620px;margin:0;color:#586a7a;font-size:13px}
  .pdf-preview-actions{display:flex;flex-wrap:wrap;gap:8px}
  .open-pdf{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 14px;border-radius:9px;background:#183452;color:white;font-size:12px;font-weight:800;text-decoration:none}
  .open-pdf--secondary{border:1px solid #d6e3df;background:#fff;color:#183452}
  .pdf-viewer-shell{overflow:hidden;border:1px solid #d9e2df;border-radius:12px;background:#e8edeb}
  .pdf-viewer-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:48px;padding:7px 12px;background:#183452;color:#fff}
  .pdf-viewer-title{overflow:hidden;font-size:12px;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
  .pdf-fullscreen{flex:none;min-height:34px;padding:6px 11px;border:1px solid rgb(255 255 255 / 35%);border-radius:7px;background:rgb(255 255 255 / 10%);color:#fff;font-size:11px;font-weight:800;cursor:pointer}
  .pdf-frame{height:clamp(480px,72vw,850px);background:#e8edeb}
  .pdf-frame object,.pdf-frame iframe{display:block;width:100%;height:100%;border:0;background:#fff}
  .pdf-viewer-shell:fullscreen{display:flex;flex-direction:column;width:100%;height:100%;border:0;border-radius:0;background:#e8edeb}
  .pdf-viewer-shell:fullscreen .pdf-frame{flex:1;min-height:0;height:auto}
  .pdf-viewer-shell:fullscreen .pdf-viewer-toolbar{flex:none}
  .pdf-viewer-help{margin:10px 2px 0;color:#647586;font-size:12px}
  .pdf-fullscreen:focus-visible,.open-pdf:focus-visible{outline:3px solid #70b9ae;outline-offset:3px}
  @media(max-width:760px){.pdf-preview-heading{align-items:stretch;flex-direction:column}.pdf-preview-actions{display:grid;grid-template-columns:1fr}.open-pdf{width:100%;text-align:center}.pdf-frame{height:68vh;min-height:420px}}
  @media(max-width:380px){.pdf-preview{padding:14px}.pdf-frame{min-height:360px}}
</style>
