---
interface Props { base: string }
const { base } = Astro.props;
const items = [
  { label: "Home", fr: "Accueil", es: "Inicio", href: base, key: "home", icon: "M3 10.8 12 3l9 7.8v9.1a1.1 1.1 0 0 1-1.1 1.1h-5.2v-6.2h-5.4V21H4.1A1.1 1.1 0 0 1 3 19.9z" },
  { label: "Explore", fr: "Explorer", es: "Explorar", href: base + "#categories", key: "explore", icon: "M12 2.8 14.5 9.5 21.2 12l-6.7 2.5L12 21.2l-2.5-6.7L2.8 12l6.7-2.5z" },
  { label: "Books", fr: "Books", es: "Libros", href: base + "books/", key: "books", icon: "M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5z M4 4.5v17 M8 6h8 M8 10h8" },
  { label: "FAQ", fr: "FAQ", es: "FAQ", href: base + "faq/", key: "faq", icon: "M9.1 9a3 3 0 1 1 5.2 2c-1.5 1.3-2.3 1.8-2.3 3.5 M12 18h.01 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" },
  { label: "About", fr: "À propos", es: "Acerca de", href: base + "about/", key: "about", icon: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M4 21a8 8 0 0 1 16 0z" }
];
const currentPath = Astro.url.pathname;
const homePath = base.endsWith("/") ? base : `${base}/`;
const active = currentPath.includes("/books") ? "books" : currentPath.includes("/faq") ? "faq" : currentPath.includes("/about") ? "about" : currentPath === homePath || currentPath === base ? "home" : "";
---
<nav class="mobile-tabbar" aria-label="Quick navigation" data-mobile-tabbar>
  {items.map((item) => (
    <a href={item.href} data-tab-key={item.key} aria-current={active === item.key ? "page" : undefined}>
      <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={item.icon}/></svg>
      <span data-en={item.label} data-fr={item.fr} data-es={item.es}>{item.label}</span>
    </a>
  ))}
</nav>
