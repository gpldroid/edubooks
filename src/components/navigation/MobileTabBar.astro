---
import Icon3D from '../ui/Icon3D.astro';
interface Props { base: string }
const { base } = Astro.props;
const items = [
  { label: "Home", fr: "Accueil", es: "Inicio", href: base, key: "home", icon: "home" },
  { label: "Explore", fr: "Explorer", es: "Explorar", href: base + "#categories", key: "explore", icon: "compass" },
  { label: "Books", fr: "Books", es: "Libros", href: base + "books/", key: "books", icon: "book" },
  { label: "FAQ", fr: "FAQ", es: "FAQ", href: base + "faq/", key: "faq", icon: "help" },
  { label: "About", fr: "À propos", es: "Acerca de", href: base + "about/", key: "about", icon: "user" }
] as const;
const currentPath = Astro.url.pathname;
const homePath = base.endsWith("/") ? base : `${base}/`;
const active = currentPath.includes("/books") ? "books" : currentPath.includes("/faq") ? "faq" : currentPath.includes("/about") ? "about" : currentPath === homePath || currentPath === base ? "home" : "";
---
<nav class="mobile-tabbar" aria-label="Quick navigation" data-mobile-tabbar>
  {items.map((item) => (
    <a href={item.href} data-tab-key={item.key} aria-current={active === item.key ? "page" : undefined}>
      <Icon3D name={item.icon} label={item.label} size={24} />
      <span data-en={item.label} data-fr={item.fr} data-es={item.es}>{item.label}</span>
    </a>
  ))}
</nav>
