---
import '../styles/legacy.css';
import '../styles/site.css';
import MobileTabBar from '../components/navigation/MobileTabBar.astro';
import ScrollControls from '../components/ui/ScrollControls.astro';
const { title = 'EduBooks — Learn. Practice. Grow.', description = 'Practical digital learning resources for every stage of the learning journey.', robots = 'index, follow, max-image-preview:large', alternates = [] as { lang: string; href: string }[] } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalPath = Astro.url.pathname.startsWith(base) ? Astro.url.pathname : base + Astro.url.pathname.replace(/^\/+/, '');
const canonical = new URL(canonicalPath, Astro.site).href;
const siteUrl = new URL(base, Astro.site).href;
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#142b4a" /><meta name="description" content={description} />
<meta name="robots" content={robots} /><link rel="canonical" href={canonical} />{alternates.map((item) => <link rel="alternate" hreflang={item.lang} href={item.href} />)}
<meta name="author" content="Imad Limrani" /><meta property="og:type" content="website" /><meta property="og:title" content={title} />
<meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:site_name" content="EduBooks" /><meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><title>{title}</title>
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebSite","name":"EduBooks","url":siteUrl,"description":description,"inLanguage":["en","fr","es"],"publisher":{"@type":"Person","name":"Imad Limrani"}})} />
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" /><noscript><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" /></noscript>
</head>
<body class={Astro.url.pathname === base || Astro.url.pathname === `${base}index.html` ? 'home-page' : 'inner-page'}>
<a class="skip-link" href="#main" data-en="Skip to content" data-fr="Aller au contenu" data-es="Ir al contenido">Skip to content</a>
<header class="site-header"><div class="container nav-wrap">
<a class="brand" href={base} aria-label="EduBooks home"><span class="brand-mark">E</span><span class="brand-name">Edu<span>Books</span><small>BY IMAD LIMRANI</small></span></a>
<button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav"><span></span><span></span><span></span></button>
<nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
<a href={base} data-en="Home" data-fr="Accueil" data-es="Inicio">Home</a>
<a href={`${base}#categories`} data-en="Explore" data-fr="Explorer" data-es="Explorar">Explore</a>
<a href={`${base}books/`} data-en="Books" data-fr="Livres" data-es="Libros">Books</a>
<a href={`${base}about/`} data-en="About" data-fr="À propos" data-es="Acerca de">About</a>
<a href={`${base}faq/`} data-en="FAQ" data-fr="FAQ" data-es="Preguntas">FAQ</a>
<a href={`${base}about/#contact`} data-en="Contact" data-fr="Contact" data-es="Contacto">Contact</a>
</nav>

</div></header>
<div class="language-float" data-language-widget>
<button class="language-globe" type="button" data-lang-toggle aria-label="Choose language" aria-expanded="false" aria-controls="language-menu">
<svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="19" fill="none" stroke="currentColor" stroke-width="2.4"/><ellipse cx="24" cy="24" rx="8.5" ry="19" fill="none" stroke="currentColor" stroke-width="2"/><path d="M6 24h36M10 14h28M10 34h28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
<span class="language-current" data-lang-current>EN</span>
</button>
<div class="language-menu" id="language-menu" data-lang-menu hidden role="group" aria-label="Choose website language">
<button type="button" data-set-lang="en" lang="en">English</button>
<button type="button" data-set-lang="fr" lang="fr">Français</button>
<button type="button" data-set-lang="es" lang="es">Español</button>
</div>
</div>
<main id="main" data-title-en={title} data-description-en={description}><slot /></main>
<footer id="page-bottom" class="site-footer"><div class="container footer-main">
<div class="footer-brand-column"><a class="brand brand-footer" href={base}><span class="brand-mark">E</span><span class="brand-name">Edu<span>Books</span><small>BY IMAD LIMRANI</small></span></a><p data-en="Thoughtful resources for a lifetime of learning." data-fr="Des ressources conçues pour apprendre tout au long de la vie." data-es="Recursos útiles para aprender durante toda la vida.">Thoughtful resources for a lifetime of learning.</p>
<div class="social-block"><span class="social-heading" data-en="Follow EduBooks" data-fr="Suivre EduBooks" data-es="Sigue a EduBooks">Follow EduBooks</span><nav class="social-icons" aria-label="EduBooks social media">
<a class="social-icon social-pinterest" href="https://www.pinterest.com/laracheblog" target="_blank" rel="noopener noreferrer" aria-label="Pinterest — opens in a new tab" title="Pinterest"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.1 2.2a9.8 9.8 0 0 0-3.57 18.93c-.02-.78 0-1.72.2-2.57l1.4-5.95s-.35-.7-.35-1.73c0-1.62.94-2.83 2.1-2.83.99 0 1.47.74 1.47 1.63 0 .99-.63 2.47-.95 3.84-.27 1.15.58 2.09 1.72 2.09 2.07 0 3.66-2.18 3.66-5.33 0-2.79-2-4.74-4.85-4.74-3.3 0-5.24 2.47-5.24 5.02 0 .99.38 2.05.86 2.63.1.12.12.23.09.36l-.32 1.3c-.05.21-.17.26-.39.16-1.45-.67-2.36-2.78-2.36-4.48 0-3.64 2.64-6.99 7.62-6.99 4 0 7.11 2.85 7.11 6.66 0 3.97-2.5 7.16-5.97 7.16-1.17 0-2.27-.61-2.65-1.33l-.72 2.75c-.26 1.01-.97 2.28-1.44 3.05.88.27 1.81.41 2.77.41a9.8 9.8 0 0 0 0-19.6z" fill="currentColor"/></svg></a>
<a class="social-icon social-instagram" href="https://www.instagram.com/larache_forum" target="_blank" rel="noopener noreferrer" aria-label="Instagram — opens in a new tab" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5.1" fill="none" stroke="currentColor" stroke-width="2.2"/><circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="2.2"/><circle cx="17.8" cy="6.4" r="1.25" fill="currentColor"/></svg></a>
<a class="social-icon social-x" href="https://x.com/limrani89664" target="_blank" rel="noopener noreferrer" aria-label="X — opens in a new tab" title="X"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 3H21l-6.85 7.83L22.2 21h-6.25l-4.9-6.42L5.43 21H3.3l7.32-8.37L2.8 3h6.4l4.43 5.85zm-1.1 16.2h1.17L7.27 4.7H6.02z" fill="currentColor"/></svg></a>
<a class="social-icon social-facebook" href="https://m.facebook.com/61577188775609" target="_blank" rel="noopener noreferrer" aria-label="Facebook — opens in a new tab" title="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.7 21v-8.2h2.8l.42-3.2H13.7V7.55c0-.93.26-1.56 1.6-1.56h1.72V3.12A22 22 0 0 0 14.5 3c-2.5 0-4.2 1.53-4.2 4.35V9.6H7.5v3.2h2.8V21z" fill="currentColor"/></svg></a>
<a class="social-icon social-threads" href="https://www.threads.com/@larache_blog" target="_blank" rel="noopener noreferrer" aria-label="Threads — opens in a new tab" title="Threads"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.1 2.1c-5.6 0-9.1 3.8-9.1 9.8 0 6.2 3.5 10 9.2 10 4.8 0 8-2.8 8-7 0-3.1-1.8-5.1-4.9-5.6-.5-2.2-1.9-3.3-4.2-3.3-2.1 0-3.6 1.1-4.1 3.1l2.1.5c.3-1 1-1.5 2-1.5 1.2 0 1.8.5 2.1 1.4-.4 0-.8 0-1.2 0-4.2 0-6.6 1.9-6.6 5.1 0 2.7 1.8 4.4 4.5 4.4 2.2 0 3.9-1.1 4.8-3 .8.7 1.2 1.7 1.2 2.9 0 2.9-2.2 4.7-5.8 4.7-4.4 0-7-3-7-7.8 0-4.8 2.6-7.7 7-7.7 2.4 0 4 .8 4.8 2.4l1.9-1C17.5 3.3 15.3 2.1 12.1 2.1zm-.3 14.8c-1.5 0-2.4-.8-2.4-2.1 0-1.8 1.4-2.9 4.4-2.9.5 0 .9 0 1.4.1-.1 2.9-1.4 4.9-3.4 4.9z" fill="currentColor"/></svg></a>
<a class="social-icon social-linkedin" href="https://ma.linkedin.com/in/imad-limrani-0221aa3aa" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn — opens in a new tab" title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 8.3H2.1V21h3.1zM3.65 2.2a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6M21.9 13.1c0-3.42-1.83-5.01-4.28-5.01a3.7 3.7 0 0 0-3.33 1.83V8.3h-3.1V21h3.1v-6.3c0-1.66.32-3.27 2.37-3.27 2.02 0 2.05 1.9 2.05 3.38V21h3.1z" fill="currentColor"/></svg></a>
<a class="social-icon social-bluesky" href="https://bsky.app/profile/3raychi.bsky.social" target="_blank" rel="noopener noreferrer" aria-label="Bluesky — opens in a new tab" title="Bluesky"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.1 3.2C7.9 5.3 10.8 9.5 12 11.8c1.2-2.3 4.1-6.5 6.9-8.6 2-1.5 5.2-2.7 5.2 1 0 .7-.4 5.8-.7 6.6-.9 2.8-4.1 3.5-7 3 5 .8 6.2 3.5 3.5 6.2-5.1 5.2-7.3-1.3-7.9-3.1-.1-.3-.2-.5-.3-.5s-.2.2-.3.5c-.6 1.8-2.8 8.3-7.9 3.1-2.7-2.7-1.5-5.4 3.5-6.2-2.9.5-6.1-.2-7-3C-.3 10 .1 4.9.1 4.2c0-3.7 3.2-2.5 5.2-1z" fill="currentColor" transform="translate(1.1 0) scale(.91)"/></svg></a>
</nav></div></div>
<div class="footer-links"><a href={`${base}about/`} data-en="About" data-fr="À propos" data-es="Acerca de">About</a><a href={`${base}faq/`} data-en="FAQ" data-fr="FAQ" data-es="Preguntas">FAQ</a><a href={`${base}privacy/`} data-en="Privacy" data-fr="Confidentialité" data-es="Privacidad">Privacy</a><a href={`${base}terms/`} data-en="Terms" data-fr="Conditions" data-es="Términos">Terms</a></div>
</div><div class="container footer-bottom"><span>© {new Date().getFullYear()} EduBooks · <span data-en="All rights reserved." data-fr="Tous droits réservés." data-es="Todos los derechos reservados.">All rights reserved.</span></span><span data-en="An independent educational publishing project by Imad Limrani." data-fr="Un projet indépendant d’édition éducative numérique par Imad Limrani." data-es="Un proyecto independiente de publicación educativa digital de Imad Limrani.">An independent educational publishing project by Imad Limrani.</span></div></footer>
<MobileTabBar base={base} />
<ScrollControls />
<script>
const languageWidget=document.querySelector<HTMLElement>('[data-language-widget]');
const languageToggle=document.querySelector<HTMLButtonElement>('[data-lang-toggle]');
const languageMenu=document.querySelector<HTMLDivElement>('[data-lang-menu]');
const currentLanguage=document.querySelector<HTMLElement>('[data-lang-current]');
const mobileMenu=document.querySelector<HTMLButtonElement>('.menu-toggle');
const nav=document.querySelector<HTMLElement>('.primary-nav');
const supported=['en','fr','es'] as const;
type SupportedLanguage=(typeof supported)[number];
let lang:SupportedLanguage='en';
try {
  const saved=localStorage.getItem('edubooks-language');
  if(saved && supported.includes(saved as SupportedLanguage)) lang=saved as SupportedLanguage;
} catch {
  // Storage may be unavailable in restricted browsing contexts.
}
function applyLanguage():void {
  document.documentElement.lang=lang;
  document.documentElement.dir='ltr';
  document.querySelectorAll<HTMLElement>('[data-en]').forEach((element)=>{
    const value=element.dataset[lang]||element.dataset.en;
    if(value===undefined) return;
    const directText=[...element.childNodes].find((node)=>node.nodeType===Node.TEXT_NODE&&node.textContent?.trim());
    if(directText) directText.textContent=value;
    else if(element.children.length===0) element.textContent=value;
  });
  document.querySelectorAll<HTMLInputElement>('[data-placeholder-en]').forEach((element)=>{
    element.placeholder=element.dataset['placeholder'+lang.toUpperCase()]||element.dataset.placeholderEn||'';
  });
  const main=document.querySelector<HTMLElement>('main');
  const heading=main?.querySelector<HTMLElement>('h1');
  const firstParagraph=main?.querySelector<HTMLElement>('p');
  const title=lang==='en' ? main?.dataset.titleEn : heading?.textContent?.trim()+' — EduBooks';
  if(title) document.title=title;
  const description=lang==='en' ? main?.dataset.descriptionEn : firstParagraph?.textContent?.trim();
  const descriptionMeta=document.querySelector<HTMLMetaElement>('meta[name="description"]');
  if(description&&descriptionMeta) descriptionMeta.content=description;
  if(currentLanguage) currentLanguage.textContent=lang.toUpperCase();
  languageMenu?.querySelectorAll<HTMLButtonElement>('[data-set-lang]').forEach((button)=>{
    button.setAttribute('aria-pressed',String(button.dataset.setLang===lang));
  });
}
function closeLanguageMenu():void {
  if(!languageMenu||!languageToggle) return;
  languageMenu.hidden=true;
  languageToggle.setAttribute('aria-expanded','false');
}
languageToggle?.addEventListener('click',()=>{
  if(!languageMenu) return;
  const willOpen=languageMenu.hidden;
  languageMenu.hidden=!willOpen;
  languageToggle.setAttribute('aria-expanded',String(willOpen));
});
languageMenu?.querySelectorAll<HTMLButtonElement>('[data-set-lang]').forEach((button)=>{
  button.addEventListener('click',()=>{
    const next=button.dataset.setLang;
    if(!next||!supported.includes(next as SupportedLanguage)) return;
    lang=next as SupportedLanguage;
    try {
      localStorage.setItem('edubooks-language',lang);
    } catch {
      // Keep the current selection for this page view.
    }
    applyLanguage();
    closeLanguageMenu();
  });
});
document.addEventListener('click',(event:MouseEvent)=>{
  const target=event.target;
  if(target instanceof Node&&languageWidget&&!languageWidget.contains(target)) closeLanguageMenu();
});
document.addEventListener('keydown',(event:KeyboardEvent)=>{
  if(event.key==='Escape') { closeLanguageMenu(); closeMobileMenu(); }
});
function closeMobileMenu():void {
  nav?.classList.remove('open');
  mobileMenu?.setAttribute('aria-expanded','false');
  mobileMenu?.setAttribute('aria-label','Open navigation');
}
mobileMenu?.addEventListener('click',()=>{
  const open=nav?.classList.toggle('open')??false;
  mobileMenu.setAttribute('aria-expanded',String(open));
  mobileMenu.setAttribute('aria-label',open?'Close navigation':'Open navigation');
});
nav?.querySelectorAll<HTMLAnchorElement>('a').forEach((link)=>{
  link.addEventListener('click',closeMobileMenu);
});
document.addEventListener('click',(event:MouseEvent)=>{
  const target=event.target;
  if(target instanceof Node&&nav&&mobileMenu&&!nav.contains(target)&&!mobileMenu.contains(target)) closeMobileMenu();
});
const scrollControls=document.querySelector<HTMLElement>('[data-scroll-controls]');
const scrollTopButton=document.querySelector<HTMLButtonElement>('[data-scroll-top]');
const scrollBottomButton=document.querySelector<HTMLButtonElement>('[data-scroll-bottom]');
function updateScrollControls():void {
  if(!scrollControls) return;
  const scrollHeight=document.documentElement.scrollHeight;
  const scrollable=scrollHeight>window.innerHeight+160;
  const nearTop=window.scrollY<180;
  const nearBottom=window.innerHeight+window.scrollY>=scrollHeight-120;
  scrollControls.classList.toggle('is-visible',scrollable&&!nearTop);
  if(scrollTopButton) {
    scrollTopButton.disabled=nearTop;
    scrollTopButton.hidden=nearTop;
  }
  if(scrollBottomButton) {
    scrollBottomButton.disabled=nearBottom;
    scrollBottomButton.hidden=nearBottom;
  }
}
const scrollBehavior:ScrollBehavior=window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth';
scrollTopButton?.addEventListener('click',()=>window.scrollTo({top:0,behavior:scrollBehavior}));
scrollBottomButton?.addEventListener('click',()=>window.scrollTo({top:document.documentElement.scrollHeight,behavior:scrollBehavior}));
window.addEventListener('scroll',updateScrollControls,{passive:true});
window.addEventListener('resize',updateScrollControls,{passive:true});
applyLanguage();
updateScrollControls();
</script>

</body></html>