---
const {
  title = 'EduBooks — Learn. Practice. Grow.',
  titleAr = 'EduBooks — تعلم. مارس. تطور.',
  description = 'Practical digital learning resources for every stage of the learning journey.',
  descriptionAr = 'موارد تعليمية عملية لمختلف مراحل رحلة التعلم.'
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalPath = Astro.url.pathname.startsWith(base) ? Astro.url.pathname : base + Astro.url.pathname.replace(/^\/+/, '');
const canonical = new URL(canonicalPath, Astro.site).href;
const siteUrl = new URL(base, Astro.site).href;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#142b4a" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Imad Limrani" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="EduBooks" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebSite","name":"EduBooks","url":siteUrl,"description":description,"inLanguage":["en","ar"],"publisher":{"@type":"Person","name":"Imad Limrani"}})} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main" data-en="Skip to content" data-ar="انتقل إلى المحتوى">Skip to content</a>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href={base} aria-label="EduBooks home"><span class="brand-mark">E</span><span class="brand-name">Edu<span>Books</span><small>BY IMAD LIMRANI</small></span></a>
        <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav"><span></span><span></span><span></span></button>
        <nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
          <a href={base} data-en="Home" data-ar="الرئيسية">Home</a>
          <a href={`${base}#categories`} data-en="Explore" data-ar="استكشف">Explore</a>
          <a href={`${base}about/`} data-en="About" data-ar="من نحن">About</a>
          <a href={`${base}faq/`} data-en="FAQ" data-ar="الأسئلة الشائعة">FAQ</a>
          <a href={`${base}about/#contact`} data-en="Contact" data-ar="اتصل بنا">Contact</a>
        </nav>
        <button class="language-switch" type="button" data-lang-switch>العربية</button>
      </div>
    </header>
    <main id="main" data-title-en={title} data-title-ar={titleAr} data-description-en={description} data-description-ar={descriptionAr}><slot /></main>
    <footer class="site-footer">
      <div class="container footer-main">
        <div><a class="brand brand-footer" href={base}><span class="brand-mark">E</span><span class="brand-name">Edu<span>Books</span><small>BY IMAD LIMRANI</small></span></a><p data-en="Thoughtful resources for a lifetime of learning." data-ar="موارد مدروسة لرحلة تعلم تستمر مدى الحياة.">Thoughtful resources for a lifetime of learning.</p></div>
        <div class="footer-links"><a href={`${base}about/`} data-en="About" data-ar="من نحن">About</a><a href={`${base}faq/`} data-en="FAQ" data-ar="الأسئلة الشائعة">FAQ</a><a href={`${base}privacy/`} data-en="Privacy" data-ar="الخصوصية">Privacy</a><a href={`${base}terms/`} data-en="Terms" data-ar="الشروط">Terms</a></div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} EduBooks · <span data-en="All rights reserved." data-ar="جميع الحقوق محفوظة.">All rights reserved.</span></span><span data-en="An independent educational publishing project by Imad Limrani." data-ar="مشروع نشر تعليمي رقمي مستقل بإشراف Imad Limrani.">An independent educational publishing project by Imad Limrani.</span></div>
    </footer>
    <script>
      const switcher = document.querySelector('[data-lang-switch]');
      const menu = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.primary-nav');
      let lang = localStorage.getItem('edubooks-language') || 'en';
      function applyLanguage() {
        document.documentElement.lang = lang;
        document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
        document.querySelectorAll('[data-en][data-ar]').forEach(el => { el.textContent = el.dataset[lang]; });
        switcher.textContent = lang === 'ar' ? 'English' : 'العربية';
        const mainTitle = document.querySelector('main');
        document.title = lang === 'ar' ? (mainTitle?.dataset.titleAr || 'EduBooks — تعلم. مارس. تطور.') : (mainTitle?.dataset.titleEn || 'EduBooks — Learn. Practice. Grow.');
        const description = lang === 'ar' ? mainTitle?.dataset.descriptionAr : mainTitle?.dataset.descriptionEn;
        if (description) {
          document.querySelector('meta[name="description"]')?.setAttribute('content', description);
          document.querySelector('meta[property="og:description"]')?.setAttribute('content', description);
        }
        document.querySelector('meta[property="og:title"]')?.setAttribute('content', document.title);
      }
      switcher?.addEventListener('click', () => { lang = lang === 'en' ? 'ar' : 'en'; localStorage.setItem('edubooks-language', lang); applyLanguage(); });
      menu?.addEventListener('click', () => { const open = nav.classList.toggle('open'); menu.setAttribute('aria-expanded', String(open)); });
      nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { nav.classList.remove('open'); menu?.setAttribute('aria-expanded', 'false'); }));
      applyLanguage();
    </script>
    <style is:global>
      :root{font-family:"DM Sans","IBM Plex Sans Arabic",sans-serif;color:#20354b;background:#fff;font-synthesis:none;text-rendering:optimizeLegibility}
      *{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}.container{width:min(1120px,calc(100% - 40px));margin:auto}
      .site-header{height:82px;background:#fff;border-bottom:1px solid #e9edf0;display:flex;align-items:center;position:sticky;top:0;z-index:10}.nav-wrap{display:flex;align-items:center;gap:28px}
      .brand{display:flex;align-items:center;gap:10px;min-width:180px}.brand-mark{width:40px;height:40px;border-radius:12px;background:#183452;color:#fff;display:grid;place-items:center;font-weight:800;font-size:22px}
      .brand-name{font-size:20px;font-weight:800;letter-spacing:-.7px;color:#183452}.brand-name>span{color:#388b82}.brand-name small{display:block;font-size:8px;letter-spacing:2px;color:#82909d}
      .primary-nav{display:flex;gap:26px;margin-inline-start:auto}.primary-nav a{font-size:13px;font-weight:700;color:#586a7a}.primary-nav a:hover{color:#388b82}
      .language-switch,.menu-toggle{border:1px solid #dce4e8;background:#fff;border-radius:8px;padding:9px 13px;color:#183452;font-weight:700;cursor:pointer}.menu-toggle{display:none}.menu-toggle span{display:block;width:17px;height:2px;background:#183452;margin:3px 0;border-radius:2px}
      .skip-link{position:absolute;left:-999px}.skip-link:focus{left:12px;top:12px;background:#fff;padding:10px;z-index:20}
      .hero{background:#183452;color:#fff;padding:88px 0 100px;overflow:hidden}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:50px;align-items:center}
      .eyebrow,.section-label{color:#9bcac2;font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase}.hero h1{font-size:clamp(44px,6vw,76px);line-height:1.05;letter-spacing:-3px;margin:22px 0}.hero h1 em{color:#9ed3ca}.hero p{color:#c3cfda;line-height:1.9;max-width:560px}
      .button{display:inline-flex;padding:14px 20px;border-radius:6px;background:#fff;color:#183452;font-weight:800;margin-top:18px}.hero-art{min-height:300px;display:grid;place-items:center}.book{width:210px;height:270px;background:linear-gradient(145deg,#e8e0ca,#8bb5ad);box-shadow:22px 24px 50px #08182c88;transform:rotate(-7deg);padding:28px;color:#183452;display:flex;flex-direction:column;justify-content:space-between}.book strong{font-size:35px;line-height:1}
      .section-pad{padding:82px 0}.intro-grid,.principles-wrap,.newsletter-wrap{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.section-pad h2{font-size:clamp(32px,4vw,48px);line-height:1.12;letter-spacing:-1.5px;color:#183452;margin:14px 0}.section-pad p{color:#657585;line-height:1.9}
      .category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:32px}.category-card{padding:26px;background:#f4f5f1;border:1px solid #e8ebe6;border-radius:8px}.category-card h3{color:#183452}.category-card p{font-size:13px}.category-card span{font-size:10px;color:#388b82;font-weight:800;text-transform:uppercase;letter-spacing:1px}
      .categories-section{background:#f1f2ed}.principles-section{background:#183452;color:#fff}.principles-section h2{color:#fff}.principles-section p{color:#c3cfda}
      .newsletter-wrap{grid-template-columns:1fr auto}.site-footer{background:#101f32;color:#fff;padding:45px 0 18px}.footer-main,.footer-bottom{display:flex;justify-content:space-between;gap:24px}.brand-footer .brand-name{color:#fff}.footer-main p,.footer-bottom{color:#9eb0c0;font-size:12px}.footer-links{display:flex;gap:25px;align-items:center;font-size:12px}.footer-bottom{border-top:1px solid #ffffff22;padding-top:18px;margin-top:32px}
      .page-hero{background:#183452;color:#fff;padding:65px 0}.page-hero h1{font-size:48px;margin:12px 0}.page-hero p{color:#c3cfda;max-width:680px;line-height:1.9}.content-section{padding:60px 0 90px}.content-section h2{color:#183452;margin-top:34px}.content-section p,.content-section li{line-height:2;color:#586a7a}.content-narrow{max-width:820px}
      body[dir=rtl]{font-family:"IBM Plex Sans Arabic","DM Sans",sans-serif}body[dir=rtl] .hero p,body[dir=rtl] .page-hero p,body[dir=rtl] .content-section p,body[dir=rtl] .content-section li{text-align:right}body[dir=rtl] .brand-name small{letter-spacing:1px}body[dir=rtl] .hero h1,body[dir=rtl] h2{letter-spacing:0}
      @media(max-width:760px){.menu-toggle{display:block;margin-inline-start:auto}.primary-nav{display:none;position:absolute;top:81px;left:0;right:0;background:#fff;padding:20px;flex-direction:column;box-shadow:0 15px 20px #10203018}.primary-nav.open{display:flex}.primary-nav a:focus-visible,.language-switch:focus-visible,.menu-toggle:focus-visible,.button:focus-visible{outline:3px solid #70b9ae;outline-offset:3px}.nav-wrap{gap:12px}.brand{min-width:0}.hero{padding:60px 0}.hero-grid,.intro-grid,.principles-wrap,.newsletter-wrap{grid-template-columns:1fr;gap:30px}.hero-art{min-height:220px}.category-grid{grid-template-columns:1fr}.footer-main,.footer-bottom{flex-direction:column}.footer-links{flex-wrap:wrap}.section-pad{padding:60px 0}}
      @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}
    </style>
  </body>
</html>