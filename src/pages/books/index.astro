---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/books/BookCard.astro';
import { books, categories, validateBookCatalog } from '../../data/catalog';

const base = import.meta.env.BASE_URL;
const catalogErrors = validateBookCatalog(books);
if (catalogErrors.length > 0) throw new Error(catalogErrors.join('\\n'));
const catalogBooks = books;
for (const book of catalogBooks) {
  const coverFile = resolve(process.cwd(), 'public', book.cover.slice(1));
  if (!existsSync(coverFile)) throw new Error(`Missing cover for "${book.slug}": ${book.cover}`);
  if (book.status === 'published') {
    const previewFile = resolve(process.cwd(), 'public', (book.previewPdf ?? '').slice(1));
    if (!existsSync(previewFile)) throw new Error(`Missing PDF preview for "${book.slug}": ${book.previewPdf}`);
  }
}

const initialCategory = Astro.url.searchParams.get('category') ?? 'all';
const validInitialCategory = initialCategory === 'all' || categories.some((category) => category.slug === initialCategory) ? initialCategory : 'all';
const visibleCategories = categories.filter((category) => catalogBooks.some((book) => book.category === category.slug));
---
<BaseLayout title="Free Educational Books and PDF Workbooks — EduBooks" description="Browse free English, French and Spanish learning books, beginner language workbooks and practical vocabulary PDFs. Read sample pages online and download complete books." keywords="free PDF books, educational books, language learning books, English beginner workbook, French language workbook, Spanish language workbook, vocabulary practice, free learning resources">
  <section class="page-hero"><div class="container"><span class="section-label">EDUBOOKS LIBRARY</span><h1 data-en="Explore the library" data-fr="Explorer la bibliothèque" data-es="Explorar la biblioteca">Explore the library</h1><p data-en="Browse two practical language-learning books in English, French and Spanish. Preview selected pages online and download each complete PDF for free." data-fr="Découvrez deux livres pratiques pour apprendre les langues, disponibles en anglais, français et espagnol. Consultez un extrait en ligne et téléchargez chaque PDF complet gratuitement." data-es="Descubre dos libros prácticos para aprender idiomas, disponibles en inglés, francés y español. Lee una muestra en línea y descarga gratis cada PDF completo.">Browse two practical language-learning books in English, French and Spanish. Preview selected pages online and download each complete PDF for free.</p></div></section>
  <section class="content-section library-section" aria-labelledby="catalog-heading"><div class="container">
    <h2 class="visually-hidden" id="catalog-heading" data-en="Books in the catalogue" data-fr="Livres du catalogue" data-es="Libros del catálogo">Books in the catalogue</h2>
    <div class="catalog-tools">
      <div class="catalog-field"><label class="search-label" for="book-search" data-en="Search the library" data-fr="Rechercher dans la bibliothèque" data-es="Buscar en la biblioteca">Search the library</label><input id="book-search" type="search" placeholder="Search books..." data-placeholder-en="Search books..." data-placeholder-fr="Rechercher des livres..." data-placeholder-es="Buscar libros..." autocomplete="off"></div>
      <p class="catalog-count" id="catalog-count" aria-live="polite" data-en="Free PDF books" data-fr="Livres PDF gratuits" data-es="Libros PDF gratuitos">Free PDF books</p>
    </div>
    <div class="catalog-layout">
      <aside class="category-sidebar" aria-labelledby="category-heading">
        <div class="category-sidebar-heading"><span class="sidebar-kicker">BROWSE BY</span><h2 id="category-heading" data-en="Categories" data-fr="Catégories" data-es="Categorías">Categories</h2><p data-en="Choose a learning area" data-fr="Choisissez un domaine" data-es="Elige un área de aprendizaje">Choose a learning area</p></div>
        <nav class="category-nav" aria-label="Book categories">
          <a class:list={['category-link', { 'is-active': validInitialCategory === 'all' }]} href={`${base}books/`} data-category-link="all" aria-current={validInitialCategory === 'all' ? 'page' : undefined}><span data-en="All books" data-fr="Tous les livres" data-es="Todos los libros">All books</span></a>
          {visibleCategories.map((category) => <a class:list={['category-link', { 'is-active': validInitialCategory === category.slug }]} href={`${base}books/?category=${category.slug}`} data-category-link={category.slug} aria-current={validInitialCategory === category.slug ? 'page' : undefined}><span data-en={category.nameEn} data-fr={category.nameFr} data-es={category.nameEs}>{category.nameEn}</span></a>)}
        </nav>
        
      </aside>
      <div class="catalog-results">
        <div class="results-heading"><div><span class="section-label" data-en="THE COLLECTION" data-fr="LA COLLECTION" data-es="LA COLECCIÓN">THE COLLECTION</span><h2 id="results-title" data-en="Explore books" data-fr="Explorer les livres" data-es="Explorar libros">Explore books</h2></div></div>
        {catalogBooks.length > 0 ? <div class="book-grid" id="book-grid">{catalogBooks.map((book) => <BookCard book={book} category={categories.find((item) => item.slug === book.category)} base={base} />)}</div> : <div class="empty-state" id="empty-state"><span class="empty-state-mark" aria-hidden="true">E</span><h2 data-en="The library is being prepared" data-fr="La bibliothèque est en préparation" data-es="La biblioteca está en preparación">The library is being prepared</h2><p data-en="There are no books in this category yet. Browse all available language-learning books instead." data-fr="Aucun livre n’est encore disponible dans cette catégorie. Consultez les livres de langues disponibles." data-es="Todavía no hay libros en esta categoría. Explora los libros de idiomas disponibles.">There are no books in this category yet. Browse all available language-learning books instead.</p></div>}
        <p class="no-results" id="no-results" hidden data-en="No books match this search or category." data-fr="Aucun livre ne correspond à cette recherche ou catégorie." data-es="Ningún libro coincide con esta búsqueda o categoría.">No books match this search or category.</p>
      </div>
    </div>
  </div></section>
  <style>
    .library-section{overflow:visible}
    .catalog-tools{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:0 0 26px}
    .catalog-field{display:grid;gap:7px;width:min(100%,560px)}
    .search-label{font-size:13px;font-weight:800;color:#183452}
    .catalog-tools input{width:100%;min-width:0;min-height:48px;padding:11px 15px;border:1px solid #dce4e8;border-radius:11px;background:#fff;color:#20354b;font:inherit;box-shadow:0 4px 12px rgb(16 31 50 / 4%)}
    .catalog-tools input:focus-visible{outline:3px solid rgb(56 139 130 / 25%);outline-offset:2px;border-color:#388b82}
    .catalog-count{margin:0 0 3px;color:#718092;font-size:13px;font-weight:700;white-space:nowrap}
    .catalog-layout{min-width:0;max-width:100%;display:grid;grid-template-columns:minmax(210px,250px) minmax(0,1fr);align-items:start;gap:clamp(22px,3vw,38px)}
    .category-sidebar{min-width:0;max-width:100%;box-sizing:border-box;position:sticky;top:22px;padding:23px 18px 18px;border:1px solid #dce8e5;border-radius:18px;background:linear-gradient(150deg,#fff 0%,#f1f7f5 100%);box-shadow:0 12px 28px rgb(24 52 82 / 7%),inset 0 1px 0 #fff;transform:perspective(900px) rotateY(1.2deg);transform-style:preserve-3d}
    .category-sidebar-heading{padding:0 7px 17px;border-bottom:1px solid #e1eae7}
    .sidebar-kicker{font-size:10px;font-weight:900;letter-spacing:.15em;color:#388b82}
    .category-sidebar-heading h2{margin:6px 0 2px;color:#183452;font-size:22px;line-height:1.2}
    .category-sidebar-heading p{margin:0;color:#718092;font-size:12px}
    .category-nav{min-width:0;max-width:100%;box-sizing:border-box;display:grid;gap:6px;padding:15px 0}
    .category-link{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:43px;padding:9px 10px;border:1px solid transparent;border-radius:10px;color:#42576a;text-decoration:none;font-size:13px;font-weight:700;transition:background .18s ease,color .18s ease,transform .18s ease,box-shadow .18s ease}
    .category-link:hover{transform:translateX(3px);background:#fff;color:#183452;box-shadow:0 5px 12px rgb(24 52 82 / 7%)}
    .category-link.is-active{background:#183452;color:#fff;box-shadow:0 7px 15px rgb(24 52 82 / 18%),inset 0 1px 0 rgb(255 255 255 / 16%)}
    .category-link:focus-visible{outline:3px solid rgb(56 139 130 / 35%);outline-offset:2px}
    .sidebar-note{display:flex;align-items:center;gap:10px;padding:13px 10px 4px;border-top:1px solid #e1eae7}
    .sidebar-note-mark{display:grid;place-items:center;flex:0 0 31px;width:31px;height:31px;border-radius:10px;background:#dcece8;color:#183452;font-weight:900}
    .sidebar-note p{margin:0;color:#718092;font-size:11px;line-height:1.55}
    .catalog-results{min-width:0;max-width:100%;perspective:1400px}
    .results-heading{display:flex;align-items:end;justify-content:space-between;gap:14px;margin:0 0 18px;padding:0 2px 13px;border-bottom:1px solid #e5ece9}
    .results-heading .section-label{font-size:10px}
    .results-heading h2{margin:4px 0 0;color:#183452;font-size:clamp(22px,2.4vw,30px);line-height:1.2}
    .book-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(14px,1.7vw,22px);align-items:stretch}
    .empty-state{max-width:760px;margin:24px auto;padding:clamp(30px,5vw,56px);text-align:center;background:linear-gradient(145deg,#f5f8f7,#edf4f2);border:1px solid #e0ebe8;border-radius:20px;box-shadow:0 12px 30px rgb(16 31 50 / 5%)}
    .empty-state-mark{display:grid;place-items:center;width:54px;height:54px;margin:0 auto 18px;border-radius:16px;background:#183452;color:#fff;font-weight:800;font-size:25px}
    .empty-state h2{font-size:clamp(24px,3vw,34px);color:#183452;margin:0 0 10px}
    .empty-state p{max-width:570px;margin:0 auto;color:#586a7a}
    .no-results{text-align:center;padding:30px 15px;color:#657585;background:#f6f7f4;border-radius:9px}
    .no-results[hidden]{display:none}
    .visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    @media(max-width:1120px){.book-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:760px){.catalog-layout{min-width:0;grid-template-columns:minmax(0,1fr);gap:20px}.category-sidebar{position:relative;top:auto;transform:none;padding:17px 15px 13px}.category-sidebar-heading{padding-bottom:12px}.category-nav{display:flex;width:100%;gap:8px;overflow-x:auto;padding:13px 1px 10px;scroll-snap-type:x proximity;scrollbar-width:thin}.category-link{flex:0 0 auto;min-height:40px;padding:8px 10px;scroll-snap-align:start}.category-link:hover{transform:translateY(-2px)}.sidebar-note{display:none}.book-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.catalog-tools{align-items:end}}
    @media(max-width:480px){.catalog-tools{display:grid;grid-template-columns:1fr;gap:10px}.catalog-count{justify-self:end}.book-grid{grid-template-columns:1fr}.results-heading h2{font-size:23px}}
    @media(prefers-reduced-motion:reduce){.category-link{transition:none}.category-link:hover{transform:none}}
  </style>
  <script>
    const search=document.querySelector<HTMLInputElement>('#book-search');
    const cards=[...document.querySelectorAll<HTMLElement>('.book-card')];
    const noResults=document.querySelector<HTMLElement>('#no-results');
    
    const categoryLinks=[...document.querySelectorAll<HTMLAnchorElement>('[data-category-link]')];
    const requested=new URLSearchParams(window.location.search).get('category')||'all';
    const validCategory=categoryLinks.some((link)=>link.dataset.categoryLink===requested)?requested:'all';
    let activeCategory=validCategory;
    function setCategory(category:string,updateUrl=false){
      activeCategory=category;
      categoryLinks.forEach((link)=>{
        const active=link.dataset.categoryLink===category;
        link.classList.toggle('is-active',active);
        if(active) link.setAttribute('aria-current','page'); else link.removeAttribute('aria-current');
      });
      const target=categoryLinks.find((link)=>link.dataset.categoryLink===category);
      const heading=document.querySelector<HTMLElement>('#results-title');
      if(heading&&target){const label=target.querySelector('span')?.textContent?.trim();heading.textContent=category==='all'?'Explore books':label||'Explore books';}
      if(updateUrl){const url=new URL(window.location.href);if(category==='all')url.searchParams.delete('category');else url.searchParams.set('category',category);window.history.pushState({},'',url);}
      filterBooks();
    }
    function filterBooks(){
      const term=(search?.value||'').trim().toLocaleLowerCase();
      let visible=0;
      cards.forEach((card)=>{
        const matchesText=(card.dataset.search||'').toLocaleLowerCase().includes(term);
        const matchesCategory=activeCategory==='all'||card.dataset.category===activeCategory;
        const show=matchesText&&matchesCategory;
        card.hidden=!show;
        if(show)visible+=1;
      });
      if(noResults)noResults.hidden=visible>0||cards.length===0;
      
    }
    categoryLinks.forEach((link)=>link.addEventListener('click',(event)=>{
      event.preventDefault();
      setCategory(link.dataset.categoryLink||'all',true);
    }));
    search?.addEventListener('input',filterBooks);
    window.addEventListener('popstate',()=>{
      const category=new URLSearchParams(window.location.search).get('category')||'all';
      setCategory(categoryLinks.some((link)=>link.dataset.categoryLink===category)?category:'all');
    });
    setCategory(activeCategory);
  </script>
</BaseLayout>
