---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookPreview from '../../components/books/BookPreview.astro';
import { books, categories, validateBookCatalog } from '../../data/catalog';

const catalogErrors = validateBookCatalog(books);
if (catalogErrors.length > 0) throw new Error(catalogErrors.join('\n'));

const publishedBooks = books.filter((book) => book.status === 'published');
for (const book of publishedBooks) {
  const previewFile = resolve(process.cwd(), 'public', book.previewPdf.slice(1));
  const coverFile = resolve(process.cwd(), 'public', book.cover.slice(1));
  if (!existsSync(previewFile)) throw new Error(`Missing PDF preview for "${book.slug}": ${book.previewPdf}`);
  if (!existsSync(coverFile)) throw new Error(`Missing cover for "${book.slug}": ${book.cover}`);
}

export function getStaticPaths() {
  return publishedBooks.map((book) => ({ params: { slug: book.slug }, props: { book } }));
}

const { book } = Astro.props;
const category = categories.find((item) => item.slug === book.category);
---
<BaseLayout title={`${book.title} — EduBooks`} description={book.description}>
  <section class="page-hero"><div class="container"><a href={`${import.meta.env.BASE_URL}books/`} class="back-link" data-en="← All books" data-fr="← Tous les livres" data-es="← Todos los libros">← All books</a><span class="section-label" data-en={category?.nameEn ?? 'EduBooks'} data-fr={category?.nameFr ?? 'EduBooks'} data-es={category?.nameEs ?? 'EduBooks'}>{category?.nameEn ?? 'EduBooks'}</span><h1 data-en={book.title} data-fr={book.titleFr} data-es={book.titleEs}>{book.title}</h1><p data-en={book.description} data-fr={book.descriptionFr} data-es={book.descriptionEs}>{book.description}</p></div></section>
  <section class="content-section"><div class="container"><BookPreview book={book} base={import.meta.env.BASE_URL} /></div></section>
  <style>.back-link{display:inline-flex;color:#b9dcd5;margin-bottom:18px;font-size:13px;text-decoration:none}</style>
</BaseLayout>
