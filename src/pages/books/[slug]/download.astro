---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { books, validateBookCatalog } from '../../../data/catalog';
const errors = validateBookCatalog(books);
if (errors.length) throw new Error(errors.join('\\n'));
export function getStaticPaths() {
  return books.filter((book) => book.status === 'published').map((book) => ({ params: { slug: book.slug }, props: { book } }));
}
const { book } = Astro.props;
if (!book.downloadPdf) throw new Error(`Missing downloadPdf for ${book.slug}`);
const relativePdfPath = book.downloadPdf.startsWith('/') ? book.downloadPdf.slice(1) : book.downloadPdf;
const pdfFile = resolve(process.cwd(), 'public', relativePdfPath);
if (!existsSync(pdfFile)) throw new Error(`Download file not found: ${book.downloadPdf}`);
const downloadUrl = `${import.meta.env.BASE_URL}${relativePdfPath}`;
---
<BaseLayout title={`Download ${book.title} — EduBooks`} description={`Download page for ${book.title}.`}>
  <section class="page-hero"><div class="container"><a class="back-link" href={`${import.meta.env.BASE_URL}books/`} data-en="← All books" data-fr="← Tous les livres" data-es="← Todos los libros">← All books</a><span class="section-label">DOWNLOAD CENTRE</span><h1 data-en="Your book is almost ready." data-fr="Votre livre est presque prêt." data-es="Tu libro está casi listo.">Your book is almost ready.</h1><p data-en={book.title} data-fr={book.titleFr} data-es={book.titleEs}>{book.title}</p></div></section>
  <section class="content-section"><div class="container"><div class="download-panel">
    <div class="download-icon" aria-hidden="true">PDF</div><h2 data-en="Prepare your download" data-fr="Préparer votre téléchargement" data-es="Preparar tu descarga">Prepare your download</h2>
    <p data-en="Please wait while we prepare your file. Your download link will become available when the timer finishes." data-fr="Veuillez patienter pendant la préparation du fichier. Le lien apparaîtra à la fin du compte à rebours." data-es="Espera mientras preparamos el archivo. El enlace estará disponible al finalizar la cuenta atrás.">Please wait while we prepare your file. Your download link will become available when the timer finishes.</p>
    <p class="timer" id="download-timer" role="status" aria-live="polite">10</p><a id="download-link" class="button-3d button-3d--dark download-button" href={downloadUrl} download hidden data-en="Download PDF" data-fr="Télécharger le PDF" data-es="Descargar PDF">Download PDF</a>
    <p class="download-note" id="download-note">The download will start after the timer.</p><a class="return-link" href={`${import.meta.env.BASE_URL}books/`}>Return to the library</a>
  </div></div></section>
  <style>.back-link{display:inline-flex;color:#b9dcd5;margin-bottom:18px;font-size:13px;text-decoration:none}.download-panel{width:min(100%,680px);margin:0 auto;padding:clamp(26px,5vw,52px);text-align:center;border:1px solid #e3e9e8;border-radius:20px;background:#fff;box-shadow:0 18px 44px rgb(16 31 50 / 8%)}.download-icon{display:grid;place-items:center;width:72px;height:72px;margin:0 auto 18px;border-radius:20px;background:#eaf3f1;color:#183452;font-size:20px;font-weight:900}.download-panel h2{font-size:clamp(24px,3vw,32px);line-height:1.25;color:#183452;margin:0 0 12px}.download-panel>p:not(.timer){color:#586a7a;line-height:1.75}.timer{font-size:clamp(42px,7vw,60px);font-weight:800;line-height:1;color:#388b82;font-variant-numeric:tabular-nums;margin:24px 0}.download-button{text-decoration:none;min-width:190px}.download-button[hidden]{display:none}.download-note{font-size:13px}.return-link{display:inline-block;margin-top:18px;color:#28776f;font-size:13px;font-weight:700}</style>
  <script>
    const timer = document.querySelector<HTMLElement>('#download-timer');
    const link = document.querySelector<HTMLAnchorElement>('#download-link');
    const note = document.querySelector<HTMLElement>('#download-note');
    let remaining = 10;
    const interval = window.setInterval(() => {
      remaining -= 1;
      if (timer) timer.textContent = String(Math.max(remaining, 0));
      if (remaining <= 0) {
        window.clearInterval(interval);
        if (timer) timer.textContent = '✓';
        if (link) link.hidden = false;
        if (note) note.textContent = 'Your PDF is ready. Select Download PDF to save it.';
      }
    }, 1000);
  </script>
</BaseLayout>
