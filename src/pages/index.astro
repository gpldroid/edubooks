---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/catalog';
const base = import.meta.env.BASE_URL;
---
<BaseLayout>
  <section class="hero"><div class="container hero-grid"><div><span class="eyebrow" data-en="A world of learning, thoughtfully made" data-fr="Un monde d’apprentissage conçu avec soin" data-es="Un mundo de aprendizaje creado con cuidado" >A world of learning, thoughtfully made</span><h1 data-en="Make every step count." data-fr="Faites compter chaque étape." data-es="Haz que cada paso cuente." >Make every step count.</h1><p data-en="Practical learning resources designed to help curious minds build skills, gain confidence and keep moving forward." data-fr="Des ressources pratiques pour développer les compétences, renforcer la confiance et progresser." data-es="Recursos prácticos para desarrollar habilidades, ganar confianza y seguir avanzando." >Practical learning resources designed to help curious minds build skills, gain confidence and keep moving forward.</p><a class="button-3d button-3d--dark" href="#categories" ><span data-en="Explore learning areas" data-fr="Explorer les domaines" data-es="Explorar áreas de aprendizaje">Explore learning areas</span><svg class="cta-icon cta-icon-spark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.8 14.1 9l6.1 2.2-6.1 2.1-2.1 6.2-2.1-6.2-6.1-2.1L9.9 9z" fill="currentColor" stroke="#d9fff4" stroke-width="1.1" stroke-linejoin="round"/><path d="m19 2 .7 2.1L22 5l-2.3.8L19 8l-.8-2.2L16 5l2.2-.9z" fill="#9ed3ca"/></svg></a></div><div class="hero-art" aria-label="EduBooks learning book illustration"><div class="book"><small>EDUBOOKS / LEARNING SERIES</small><strong>LEARN<br/>BY<br/>DOING.</strong><small>A BETTER WAY TO GROW</small></div></div></div></section>
  <section class="section-pad"><div class="container intro-grid"><div><span class="section-label" style="color:#388b82" data-en="THE EDUBOOKS PROMISE" data-fr="LA PROMESSE EDUBOOKS" data-es="LA PROMESA DE EDUBOOKS" >THE EDUBOOKS PROMISE</span><h2 data-en="Learning should feel within reach." data-fr="L’apprentissage doit être accessible." data-es="El aprendizaje debe estar al alcance de todos." >Learning should feel within reach.</h2></div><p data-en="We believe good educational material makes complex ideas clearer and learning more active. EduBooks is an independent digital publishing project focused on useful, carefully structured resources for learners, families and educators." data-fr="Nous pensons qu’un bon contenu pédagogique clarifie les idées complexes et rend l’apprentissage actif. EduBooks est un projet indépendant d’édition numérique destiné aux apprenants, aux familles et aux enseignants." data-es="Creemos que un buen material educativo aclara ideas complejas y hace que el aprendizaje sea más activo. EduBooks es un proyecto independiente de publicación digital para estudiantes, familias y docentes." >We believe good educational material makes complex ideas clearer and learning more active. EduBooks is an independent digital publishing project focused on useful, carefully structured resources for learners, families and educators.</p></div></section>
  <section class="section-pad categories-section" id="categories"><div class="container"><span class="section-label" style="color:#388b82" data-en="A PLACE TO START" data-fr="UN POINT DE DÉPART" data-es="UN LUGAR PARA EMPEZAR" >A PLACE TO START</span><h2 data-en="Explore learning areas" data-fr="Explorer les domaines d’apprentissage" data-es="Explorar áreas de aprendizaje" >Explore learning areas</h2><div class="category-grid">
    {categories.map((category,i)=><article class="category-card"><span>0{i+1}</span><h3 data-en={category.nameEn} data-fr={category.nameFr} data-es={category.nameEs} >{category.nameEn}</h3><p data-en={category.descriptionEn} data-fr={category.descriptionFr} data-es={category.descriptionEs} >{category.description}</p><a class="button-3d button-3d--compact category-link" href={`${base}books/?category=${category.slug}`} ><span data-en="Explore collection" data-fr="Voir la collection" data-es="Ver la colección">Explore collection</span><svg class="cta-icon cta-icon-book" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.5 5.2c3.3-.9 6-.4 8.5 1.4v13c-2.5-1.8-5.2-2.3-8.5-1.4z" fill="currentColor" stroke="#d9fff4" stroke-width="1.1" stroke-linejoin="round"/><path d="M20.5 5.2c-3.3-.9-6-.4-8.5 1.4v13c2.5-1.8 5.2-2.3 8.5-1.4z" fill="#9ed3ca" stroke="#e5fff9" stroke-width="1.1" stroke-linejoin="round"/><path d="M6 9.2c1.5-.2 2.7.1 4 1M6 12.2c1.5-.2 2.7.1 4 1M18 9.2c-1.5-.2-2.7.1-4 1M18 12.2c-1.5-.2-2.7.1-4 1" stroke="#183452" stroke-width="1" stroke-linecap="round"/></svg></a></article>)}
  </div></div></section>
  <section class="section-pad principles-section"><div class="container principles-wrap"><div><span class="section-label" data-en="OUR EDITORIAL PRINCIPLES" data-fr="NOS PRINCIPES ÉDITORIAUX" data-es="NUESTROS PRINCIPIOS EDITORIALES" >OUR EDITORIAL PRINCIPLES</span><h2 data-en="Useful by design. Clear by nature." data-fr="Utile par conception. Clair par nature." data-es="Útil por diseño. Claro por naturaleza." >Useful by design. Clear by nature.</h2><p data-en="Every resource should have a purpose, a clear structure and a practical benefit for the person using it." data-fr="Chaque ressource doit avoir un objectif, une structure claire et une utilité pratique." data-es="Cada recurso debe tener un propósito, una estructura clara y un beneficio práctico." >Every resource should have a purpose, a clear structure and a practical benefit for the person using it.</p></div><div><p>01 — <strong data-en="Clarity first" data-fr="La clarté avant tout" data-es="La claridad es lo primero" >Clarity first</strong></p><p>02 — <strong data-en="Practice matters" data-fr="La pratique compte" data-es="La práctica importa" >Practice matters</strong></p><p>03 — <strong data-en="Respect every learner" data-fr="Respecter chaque apprenant" data-es="Respetar a cada estudiante" >Respect every learner</strong></p></div></div></section>
  <section class="section-pad"><div class="container newsletter-wrap"><div><h2 data-en="A thoughtful library is taking shape." data-fr="Une bibliothèque soigneusement conçue prend forme." data-es="Una biblioteca cuidadosamente diseñada está tomando forma." >A thoughtful library is taking shape.</h2><p data-en="The first collections are in preparation. Follow the project for launch updates." data-fr="Les premières collections sont en préparation. Suivez le projet pour connaître les nouveautés." data-es="Las primeras colecciones están en preparación. Sigue el proyecto para conocer las novedades." >The first collections are in preparation. Follow the project for launch updates.</p></div><a class="button-3d button-3d--dark" href={`${base}about/`} ><span data-en="Get in touch" data-fr="Nous contacter" data-es="Contactar">Get in touch</span><svg class="cta-icon cta-icon-mail" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6.5A2.5 2.5 0 0 1 5.5 4h13A2.5 2.5 0 0 1 21 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z" fill="currentColor" stroke="#d9fff4" stroke-width="1.1"/><path d="m4 6 8 6.3L20 6" fill="none" stroke="#183452" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="m4 18 5.7-5M20 18l-5.7-5" fill="none" stroke="#9ed3ca" stroke-width="1.3" stroke-linecap="round"/></svg></a></div></section>
</BaseLayout>