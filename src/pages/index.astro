---
import BaseLayout from '../layouts/BaseLayout.astro';
import { books, categories } from '../data/catalog';
const visibleCategories = categories.filter((category) => books.some((book) => book.category === category.slug));
const foundations = books.find((book) => book.slug === 'language-foundations-en');
const vocabulary = books.find((book) => book.slug === 'essential-vocabulary-en');
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="EduBooks — Free Educational Books and PDF Workbooks" description="Explore free educational books and practical PDF workbooks for beginner language learning, English, French and Spanish vocabulary. Preview books online and download complete PDFs." keywords="free educational books, free PDF books, language learning, English workbook, French workbook, Spanish workbook, beginner language practice, everyday vocabulary">
  <section class="hero"><div class="container hero-grid"><div><span class="eyebrow" data-en="A world of learning, thoughtfully made" data-fr="Un monde d’apprentissage conçu avec soin" data-es="Un mundo de aprendizaje creado con cuidado">A world of learning, thoughtfully made</span><h1 data-en="Make every step count." data-fr="Faites compter chaque étape." data-es="Haz que cada paso cuente.">Make every step count.</h1><p data-en="Practical learning resources designed to help curious minds build skills, gain confidence and keep moving forward." data-fr="Des ressources pratiques pour développer les compétences, renforcer la confiance et progresser." data-es="Recursos prácticos para desarrollar habilidades, ganar confianza y seguir avanzando.">Practical learning resources designed to help curious minds build skills, gain confidence and keep moving forward.</p><a class="button-3d button-3d--dark" href={base + "books/"}><span data-en="Explore learning areas" data-fr="Explorer les domaines" data-es="Explorar áreas de aprendizaje">Explore learning areas</span><svg class="cta-icon cta-icon-spark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.8 14.1 9l6.1 2.2-6.1 2.1-2.1 6.2-2.1-6.2-6.1-2.1L9.9 9z" fill="currentColor" stroke="#d9fff4" stroke-width="1.1" stroke-linejoin="round"/><path d="m19 2 .7 2.1L22 5l-2.3.8L19 8l-.8-2.2L16 5l2.2-.9z" fill="#9ed3ca"/></svg></a></div><div class="hero-art" aria-label="EduBooks learning book illustration"><div class="book"><small>EDUBOOKS / LEARNING SERIES</small><strong>LEARN<br/>BY<br/>DOING.</strong><small>A BETTER WAY TO GROW</small></div></div></div></section>
  <section class="section-pad"><div class="container intro-grid"><div><span class="section-label" style="color:#388b82" data-en="THE EDUBOOKS PROMISE" data-fr="LA PROMESSE EDUBOOKS" data-es="LA PROMESA DE EDUBOOKS">THE EDUBOOKS PROMISE</span><h2 data-en="Learning should feel within reach." data-fr="L’apprentissage doit être accessible." data-es="El aprendizaje debe estar al alcance de todos.">Learning should feel within reach.</h2></div><p data-en="We believe good educational material makes complex ideas clearer and learning more active. EduBooks is an independent digital publishing project focused on useful, carefully structured resources for learners, families and educators." data-fr="Nous pensons qu’un bon contenu pédagogique clarifie les idées complexes et rend l’apprentissage actif. EduBooks est un projet indépendant d’édition numérique destiné aux apprenants, aux familles et aux enseignants." data-es="Creemos que un buen material educativo aclara ideas complejas y hace que el aprendizaje sea más activo. EduBooks es un proyecto independiente de publicación digital para estudiantes, familias y docentes.">We believe good educational material makes complex ideas clearer and learning more active. EduBooks is an independent digital publishing project focused on useful, carefully structured resources for learners, families and educators.</p></div></section>
  <section class="section-pad categories-section" id="categories"><div class="container"><span class="section-label" style="color:#388b82" data-en="A PLACE TO START" data-fr="UN POINT DE DÉPART" data-es="UN LUGAR PARA EMPEZAR">A PLACE TO START</span><h2 data-en="Explore learning areas" data-fr="Explorer les domaines d’apprentissage" data-es="Explorar áreas de aprendizaje">Explore learning areas</h2><div class="category-grid">
    {visibleCategories.map((category)=><article class="category-card"><h3 data-en={category.nameEn} data-fr={category.nameFr} data-es={category.nameEs}>{category.nameEn}</h3><p data-en={category.descriptionEn} data-fr={category.descriptionFr} data-es={category.descriptionEs}>{category.descriptionEn}</p><a class="button-3d button-3d--compact category-link" href={`${base}books/?category=${category.slug}`}><span data-en="Explore collection" data-fr="Voir la collection" data-es="Ver la colección">Explore collection</span><svg class="cta-icon cta-icon-book" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.5 5.2c3.3-.9 6-.4 8.5 1.4v13c-2.5-1.8-5.2-2.3-8.5-1.4z" fill="currentColor" stroke="#d9fff4" stroke-width="1.1" stroke-linejoin="round"/><path d="M20.5 5.2c-3.3-.9-6-.4-8.5 1.4v13c2.5-1.8 5.2-2.3 8.5-1.4z" fill="#9ed3ca" stroke="#e5fff9" stroke-width="1.1" stroke-linejoin="round"/><path d="M6 9.2c1.5-.2 2.7.1 4 1M6 12.2c1.5-.2 2.7.1 4 1M18 9.2c-1.5-.2-2.7.1-4 1M18 12.2c-1.5-.2-2.7.1-4 1" stroke="#183452" stroke-width="1" stroke-linecap="round"/></svg></a></article>)}
  </div></div></section>

  <section class="book-feature book-feature--foundations section-pad" id="language-foundations">
    <div class="container book-feature-grid">
      <div class="book-feature-copy">
        <span class="section-label" data-en="LANGUAGE FOUNDATIONS" data-fr="FONDAMENTAUX DES LANGUES" data-es="FUNDAMENTOS DE IDIOMAS">BOOK 01 · LANGUAGE FOUNDATIONS</span>
        <h2 data-en="Start communicating with confidence." data-fr="Commencez à communiquer avec confiance." data-es="Empieza a comunicarte con confianza.">Start communicating with confidence.</h2>
        <p data-en="A guided first step through the alphabet, pronunciation, greetings, introductions and the building blocks of simple sentences in English, French and Spanish." data-fr="Un premier parcours guidé à travers l’alphabet, la prononciation, les salutations, les présentations et les bases des phrases simples en anglais, français et espagnol." data-es="Un primer recorrido guiado por el alfabeto, la pronunciación, los saludos, las presentaciones y las bases de las frases sencillas en inglés, francés y español.">A guided first step through the alphabet, pronunciation, greetings, introductions and the building blocks of simple sentences in English, French and Spanish.</p>
        <ul class="feature-points"><li data-en="Alphabet, spelling and first sounds" data-fr="Alphabet, orthographe et premiers sons" data-es="Alfabeto, deletreo y primeros sonidos">Alphabet, spelling and first sounds</li><li data-en="Greetings and personal introductions" data-fr="Salutations et présentations personnelles" data-es="Saludos y presentaciones personales">Greetings and personal introductions</li><li data-en="Numbers, dates, questions and first sentences" data-fr="Nombres, dates, questions et premières phrases" data-es="Números, fechas, preguntas y primeras frases">Numbers, dates, questions and first sentences</li></ul>
      </div>
      <article class="publication-card publication-card--navy"><a class="publication-card-link" href={base + "books/" + (foundations?.slug ?? "language-foundations-en") + "/"} aria-label="View Language Foundations editions">
        <div class="publication-card-top"><span class="publication-series">EDUBOOKS · LANGUAGE SERIES</span><span class="publication-status" data-en="Free PDF" data-fr="PDF gratuit" data-es="PDF gratuito">Free PDF</span></div>
        <div class="publication-cover publication-cover--foundations"><span class="cover-kicker">PRE-A1 → A1</span><strong>LANGUAGE<br/>FOUNDATIONS</strong><span class="cover-subtitle">ENGLISH · FRANÇAIS · ESPAÑOL</span><span class="cover-symbol">Aa</span></div>
        <div class="publication-card-bottom"><div><h3>Language Foundations</h3><p data-en="Beginner language skills" data-fr="Bases de langues pour débutants" data-es="Bases de idiomas para principiantes">10 units · Beginner learning target</p></div></div>
        <p class="publication-disclaimer" data-en="Free PDF · Read online and download." data-fr="PDF gratuit · Lecture en ligne et téléchargement." data-es="PDF gratuito · Lectura en línea y descarga.">Preview online and download the complete PDF for free.</p></a>
        <nav class="home-edition-links" aria-label="Language editions">
          {books.filter((edition) => edition.slug.startsWith('language-foundations-')).map((edition) => <a href={base + 'books/' + edition.slug + '/'} lang={edition.language}>{edition.language.toUpperCase()}</a>)}
        </nav>
      </article>
    </div>
  </section>

  <section class="book-feature book-feature--vocabulary section-pad" id="essential-vocabulary">
    <div class="container book-feature-grid book-feature-grid--reverse">
      <article class="publication-card publication-card--teal"><a class="publication-card-link" href={base + "books/" + (vocabulary?.slug ?? "essential-vocabulary-en") + "/"} aria-label="View Essential Vocabulary editions">
        <div class="publication-card-top"><span class="publication-series">EDUBOOKS · LANGUAGE SERIES</span><span class="publication-status" data-en="Free PDF" data-fr="PDF gratuit" data-es="PDF gratuito">Free PDF</span></div>
        <div class="publication-cover publication-cover--vocabulary"><span class="cover-kicker">A1 → A2</span><strong>ESSENTIAL<br/>VOCABULARY</strong><span class="cover-subtitle">WORDS IN REAL-LIFE CONTEXT</span><div class="vocabulary-orbit"><span>HOME</span><span>FOOD</span><span>TRAVEL</span><span>PEOPLE</span></div></div>
        <div class="publication-card-bottom"><div><h3>Essential Vocabulary</h3><p data-en="Everyday vocabulary" data-fr="Vocabulaire du quotidien" data-es="Vocabulario cotidiano">12 units · Everyday vocabulary</p></div></div>
        <p class="publication-disclaimer" data-en="Preview online and download the complete PDF for free." data-fr="Consultez un extrait et téléchargez le PDF complet gratuitement." data-es="Lee una muestra y descarga gratis el PDF completo.">Preview online and download the complete PDF for free.</p>
      </a>
        <nav class="home-edition-links" aria-label="Language editions">
          {books.filter((edition) => edition.slug.startsWith('essential-vocabulary-')).map((edition) => <a href={base + 'books/' + edition.slug + '/'} lang={edition.language}>{edition.language.toUpperCase()}</a>)}
        </nav>
      </article>
      <div class="book-feature-copy">
        <span class="section-label" data-en="ESSENTIAL VOCABULARY" data-fr="VOCABULAIRE ESSENTIEL" data-es="VOCABULARIO ESENCIAL">ESSENTIAL VOCABULARY</span>
        <h2 data-en="Build vocabulary you can actually use." data-fr="Développez un vocabulaire vraiment utile." data-es="Construye un vocabulario que puedas usar.">Build vocabulary you can actually use.</h2>
        <p data-en="Learn useful words through everyday situations, natural word partnerships and short communication tasks — not isolated translation lists." data-fr="Apprenez des mots utiles à travers des situations quotidiennes, des associations naturelles et de courtes activités de communication — pas des listes de traductions isolées." data-es="Aprende palabras útiles mediante situaciones cotidianas, combinaciones naturales y breves actividades comunicativas, no con listas de traducciones aisladas.">Learn useful words through everyday situations, natural word partnerships and short communication tasks — not isolated translation lists.</p>
        <ul class="feature-points"><li data-en="People, home, food and daily routines" data-fr="Personnes, maison, alimentation et routines" data-es="Personas, hogar, comida y rutinas">People, home, food and daily routines</li><li data-en="Shopping, travel, work, health and leisure" data-fr="Achats, voyages, travail, santé et loisirs" data-es="Compras, viajes, trabajo, salud y ocio">Shopping, travel, work, health and leisure</li><li data-en="Collocations, false friends and spaced review" data-fr="Collocations, faux amis et révision espacée" data-es="Colocaciones, falsos amigos y repaso espaciado">Collocations, false friends and spaced review</li></ul>
      </div>
    </div>
  </section>

  <section class="practice-feature section-pad" id="practice-path">
    <div class="container">
      <div class="practice-heading"><div><span class="section-label" data-en="FROM KNOWING TO DOING" data-fr="DE LA CONNAISSANCE À LA PRATIQUE" data-es="DEL CONOCIMIENTO A LA PRÁCTICA">FROM KNOWING TO DOING</span><h2 data-en="A practical path through both books." data-fr="Un parcours pratique à travers les deux livres." data-es="Un recorrido práctico por ambos libros.">A practical path through both books.</h2></div><p data-en="The two workbooks connect foundational language skills with the vocabulary and routines learners need in everyday communication." data-fr="Les deux cahiers relient les bases de la langue au vocabulaire et aux habitudes nécessaires pour communiquer au quotidien." data-es="Los dos cuadernos conectan las bases del idioma con el vocabulario y las rutinas necesarias para comunicarse cada día.">The two workbooks connect foundational language skills with the vocabulary and routines learners need in everyday communication.</p></div>
      <div class="practice-card-row">
        <article class="practice-card practice-card--one"><div class="practice-icon">Aa</div><h3 data-en="Build the basics" data-fr="Construire les bases" data-es="Construir los fundamentos">Build the basics</h3><p data-en="Recognise sounds, spell words and form your first clear sentences." data-fr="Reconnaître les sons, épeler les mots et former vos premières phrases." data-es="Reconocer sonidos, deletrear palabras y formar tus primeras frases claras.">Recognise sounds, spell words and form your first clear sentences.</p><a href={base + "books/" + (foundations?.slug ?? "language-foundations-en") + "/"} data-en="Explore book" data-fr="Découvrir le livre 01" data-es="Explorar el libro 01">Explore Book 01</a></article>
        <article class="practice-card practice-card--two"><div class="practice-icon">✳</div><h3 data-en="Grow useful vocabulary" data-fr="Enrichir le vocabulaire utile" data-es="Ampliar el vocabulario útil">Grow useful vocabulary</h3><p data-en="Learn words in context and combine them into natural expressions." data-fr="Apprendre les mots en contexte et les associer dans des expressions naturelles." data-es="Aprender palabras en contexto y combinarlas en expresiones naturales.">Learn words in context and combine them into natural expressions.</p><a href={base + "books/" + (vocabulary?.slug ?? "essential-vocabulary-en") + "/"} data-en="Explore book" data-fr="Découvrir le livre 02" data-es="Explorar el libro 02">Explore Book 02</a></article>
        <article class="practice-card practice-card--three"><div class="practice-icon">✎</div><h3 data-en="Practice and review" data-fr="Pratiquer et réviser" data-es="Practicar y repasar">Practice and review</h3><p data-en="Use short speaking, writing and recall activities to make progress visible." data-fr="Utiliser de courtes activités orales, écrites et de mémorisation pour suivre vos progrès." data-es="Usar actividades breves de expresión oral, escritura y memoria para observar tu progreso.">Use short speaking, writing and recall activities to make progress visible.</p><a href={base + "books/"} data-en="Browse all books" data-fr="Parcourir les domaines" data-es="Ver áreas de aprendizaje">Browse learning areas</a></article>
      </div>
    </div>
  </section>

  <section class="section-pad principles-section"><div class="container principles-wrap"><div><span class="section-label" data-en="OUR EDITORIAL PRINCIPLES" data-fr="NOS PRINCIPES ÉDITORIAUX" data-es="NUESTROS PRINCIPIOS EDITORIALES">OUR EDITORIAL PRINCIPLES</span><h2 data-en="Useful by design. Clear by nature." data-fr="Utile par conception. Clair par nature." data-es="Útil por diseño. Claro por naturaleza.">Useful by design. Clear by nature.</h2><p data-en="Every resource should have a purpose, a clear structure and a practical benefit for the person using it." data-fr="Chaque ressource doit avoir un objectif, une structure claire et une utilité pratique." data-es="Cada recurso debe tener un propósito, una estructura clara y un beneficio práctico.">Every resource should have a purpose, a clear structure and a practical benefit for the person using it.</p></div><div><p><strong data-en="Clarity first" data-fr="La clarté avant tout" data-es="La claridad es lo primero">Clarity first</strong></p><p><strong data-en="Practice matters" data-fr="La pratique compte" data-es="La práctica importa">Practice matters</strong></p><p><strong data-en="Respect every learner" data-fr="Respecter chaque apprenant" data-es="Respetar a cada estudiante">Respect every learner</strong></p></div></div></section>
  <section class="section-pad"><div class="container newsletter-wrap"><div><h2 data-en="A thoughtful library is taking shape." data-fr="Une bibliothèque soigneusement conçue prend forme." data-es="Una biblioteca cuidadosamente diseñada está tomando forma.">A thoughtful library is taking shape.</h2><p data-en="Explore the library, read a sample online and download a complete book at no cost." data-fr="Explorez la bibliothèque, lisez un extrait en ligne et téléchargez gratuitement un livre complet." data-es="Explora la biblioteca, lee una muestra en línea y descarga un libro completo gratis.">Explore the library, read a sample online and download a complete book at no cost.</p></div><a class="button-3d button-3d--dark" href={`${base}about/`}><span data-en="Get in touch" data-fr="Nous contacter" data-es="Contactar">Get in touch</span><svg class="cta-icon cta-icon-mail" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6.5A2.5 2.5 0 0 1 5.5 4h13A2.5 2.5 0 0 1 21 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z" fill="currentColor" stroke="#d9fff4" stroke-width="1.1"/><path d="m4 6 8 6.3L20 6" fill="none" stroke="#183452" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="m4 18 5.7-5M20 18l-5.7-5" fill="none" stroke="#9ed3ca" stroke-width="1.3" stroke-linecap="round"/></svg></a></div></section>
</BaseLayout>
